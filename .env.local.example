# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service role key: server-only, never exposed to the browser. Used by the
# Next.js server (Server Components, Route Handlers) to read/write data,
# since this app has no Supabase Auth / login of its own.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public anon key: safe to expose to the browser. Used ONLY to perform
# direct browser -> Supabase Storage uploads via a signed upload URL (see
# briefing section 6). This lets large video uploads bypass Vercel's
# serverless function body-size limit instead of proxying through our
# server. It grants no table access — RLS on every table has no anon
# policies (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Max video upload size in MB (see briefing section 6). Larger files fall
# back to the external mediaLink field (Drive/Canva).
NEXT_PUBLIC_MAX_UPLOAD_MB=200
